# Preserve PDF byte offsets and xref records.
*.pdf binary

# Preserve vendored binaries and upstream license notices exactly on all hosts.
native_tools/*/bin/* binary
native_tools/*/tessdata/* binary
native_tools/licenses/** -text -whitespace

# Signed fixtures: the signature covers the bytes as they are.
test/fixtures/signatures/** binary

# Decisions as Bedesten gave them: the measured offsets count their bytes.
test/fixtures/decisions/** -text
